# ROM binaries and generated ROM builds. The .md extension is Mega Drive ROM
# here, not Markdown.
/Langrisser II*.md
/roms/**/*.md
/roms/builds/*.manifest.json

# Emulator binaries, downloaded archives, and external reference packages.
/tools/blastem/
/tools/blastem64-*.tar.gz
/external/*.zip

# Test captures and analysis output.
/run*/
/analysis_tiles/
/captures/
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.bin
/vram[0-9]*
/tmp/
/editor/static/.ai-class-sprites-build-*/
*.xwd
*.log

